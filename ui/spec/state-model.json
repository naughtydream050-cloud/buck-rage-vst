{
  "schemaVersion": 1,
  "implementationStatus": "planned-not-started",
  "dimensions": { "bars": 64, "countsPerBar": 16, "countSlots": 1024 },
  "globalApvts": ["bypass"],
  "uiState": ["visibleBarPage", "selectedBar", "selectedCount"],
  "runtimeHostSnapshot": ["hostSyncAvailable", "playing", "bpm", "timeSignatureNumerator", "timeSignatureDenominator", "playingBar"],
  "countSlot": {
    "preset": { "type": "enum", "values": ["OFF","FORWARD_CUT","BACKSPIN","CHIRP","BABY","TRANSFORM","DRAG","ZIGZAG","TAPE_BRAKE","CUSTOM"] },
    "length": { "type": "enum", "values": ["SIXTEENTH","EIGHTH","QUARTER","HALF","ONE_BAR"] },
    "speed": { "type": "float", "min": -1.0, "max": 1.0, "default": 0.0 },
    "pitch": { "type": "float", "min": -24.0, "max": 24.0, "default": 0.0 },
    "depth": { "type": "float", "min": 0.0, "max": 1.0, "default": 0.5 },
    "customMotion": { "type": "bool", "default": false },
    "motion": { "type": "fixedCapacityPoints", "capacity": 256, "point": { "x": [0.0,1.0], "y": [0.0,1.0] } }
  },
  "serialization": { "format": "versioned ValueTree binary", "rootType": "TOYOTOMI_HIDEYOSHI_STATE", "validateOnRead": true, "rejectOversizedMotion": true },
  "realtimeBoundary": { "processBlockMayReadPattern": false, "valueTreeAccess": false, "allocation": false, "mutex": false }
}
